<abstract:PageBase
    x:Class="Pango.Desktop.Uwp.Views.GeneratePasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Pango.Desktop.Uwp.Core.Localization"
    xmlns:viewmodels="using:Pango.Desktop.Uwp.ViewModels"
    xmlns:abstract="using:Pango.Desktop.Uwp.Views.Abstract"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:GeneratePasswordViewModel}"
    d:DesignWidth="800"
    d:DesignHeight="600">

    <Grid>
        <Grid x:Name="RootGrid"
              Margin="{StaticResource PageContentContainerMargin}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- page title -->
            <TextBlock Grid.Row="0"
                       Text="{loc:StringResource Key=GeneratePassword_Title}"
                       Style="{StaticResource HeaderTextBlockStyle}"/>

            <!-- scrollable content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,12,0">

                <StackPanel MaxWidth="560"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,24">

                     <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="20,16,16,16">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- password field + buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding GeneratedPassword}"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     FontSize="16"
                                     MinHeight="40"
                                     Padding="12,8"
                                     Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                <Button Width="40" Height="40"
                                        CornerRadius="6"
                                        Padding="0"
                                        ToolTipService.ToolTip="{loc:StringResource Key=CopyPassword}"
                                        Command="{Binding CopyPasswordCommand}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                </Button>

                                <Button Width="40" Height="40"
                                        CornerRadius="6"
                                        Padding="0"
                                        ToolTipService.ToolTip="{loc:StringResource Key=RegeneratePassword}"
                                        Command="{Binding RegeneratePasswordCommand}"
                                        Click="RegenerateButton_Click">
                                    <FontIcon x:Name="RefreshIcon"
                                              Glyph="&#xE72C;" FontSize="16"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <CompositeTransform/>
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                            </StackPanel>
                            
                            </Grid>

                        <!-- strength indicator bar + label -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- strength progress bar -->
                            <Grid Grid.Row="0"
                                  Width="480"
                                  Height="6"
                                  CornerRadius="3"
                                  HorizontalAlignment="Left"
                                  Background="{ThemeResource ControlFillColorDisabledBrush}">
                                <Grid CornerRadius="3"
                                      HorizontalAlignment="Left"
                                      Background="{Binding StrengthBrush}"
                                      Width="{Binding StrengthBarWidth}"/>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                <FontIcon Glyph="&#xE72E;" FontSize="12"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{Binding StrengthBrush}"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:StringResource Key=PasswordStrength}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StrengthLabel}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StrengthBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- password length -->
                    <StackPanel Margin="0,24,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xECC6;" FontSize="14"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:StringResource Key=PasswordLength}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    Minimum="8"
                                    Maximum="64"
                                    Value="{Binding Length, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>

                            <Grid Grid.Column="1" Width="64">
                                <TextBox x:Name="LengthTextBox"
                                         Text="{Binding Length,
                                                        Mode=TwoWay,
                                                        Converter={StaticResource IntToStringConverter},
                                                        UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource DefaultTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         InputScope="Number"
                                         ToolTipService.ToolTip="{loc:StringResource Key=PasswordLengthTooltip}"
                                         MinHeight="36"
                                         Padding="8,4">
                                    <TextBox.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="MaxLength" Value="2"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Grid>

                        <!-- length error -->
                        <TextBlock Text="{Binding LengthError}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding LengthError,
                                                Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- character sets -->
                    <StackPanel Margin="0,24,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="14"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:StringResource Key=CharactersToUse}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- character set toggles — card style -->
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="4,4">

                            <StackPanel>
                                <!-- uppercase row -->
                                <Grid Padding="16,10" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="ABC"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Width="48"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:StringResource Key=UseUppercase}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{Binding UseUppercase, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{loc:StringResource Key=UseUppercaseTooltip}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  Margin="20,0,0,0"/>
                                </Grid>

                                <Border Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="16,0"/>

                                <!-- lowercase row -->
                                <Grid Padding="16,10" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="abc"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Width="48"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:StringResource Key=UseLowercase}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{Binding UseLowercase, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{loc:StringResource Key=UseLowercaseTooltip}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  Margin="20,0,0,0"/>
                                </Grid>

                                <Border Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="16,0"/>

                                <!-- digits row -->
                                <Grid Padding="16,10" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="123"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Width="48"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:StringResource Key=UseDigits}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{Binding UseDigits, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{loc:StringResource Key=UseDigitsTooltip}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  Margin="20,0,0,0"/>
                                </Grid>

                                <Border Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="16,0"/>

                                <!-- special row -->
                                <Grid Padding="16,10" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="@#$"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Width="48"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:StringResource Key=UseSpecial}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2"
                                                  IsOn="{Binding UseSpecial, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{loc:StringResource Key=UseSpecialTooltip}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  Margin="20,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- exclude ambiguous -->
                        <CheckBox Margin="0,12,0,0"
                                  Content="{loc:StringResource Key=ExcludeAmbiguousCharacters}"
                                  ToolTipService.ToolTip="{loc:StringResource Key=ExcludeAmbiguousTooltip}"
                                  IsChecked="{Binding ExcludeAmbiguous, Mode=TwoWay}"/>

                        <!-- charset error -->
                        <TextBlock Text="{Binding CharsetsError}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding CharsetsError,
                                                Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- action buttons -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                MinWidth="120"
                                Height="36"
                                Style="{StaticResource DefaultButtonStyle}"
                                Command="{Binding GenerateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                <TextBlock Text="{loc:StringResource Key=Generate}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                MinWidth="120"
                                Height="36"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveAsCommand}"
                                Visibility="{Binding GeneratedPassword,
                                              Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                <TextBlock Text="{loc:StringResource Key=SaveAs}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</abstract:PageBase>
