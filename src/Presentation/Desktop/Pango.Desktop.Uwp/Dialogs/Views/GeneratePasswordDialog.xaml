<?xml version="1.0" encoding="utf-8"?>
<views:DialogPage
    x:Class="Pango.Desktop.Uwp.Dialogs.Views.GeneratePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Pango.Desktop.Uwp.Core.Localization"
    xmlns:dialogviewmodels="using:Pango.Desktop.Uwp.Dialogs.ViewModels"
    xmlns:views="using:Pango.Desktop.Uwp.Dialogs.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=dialogviewmodels:GeneratePasswordDialogViewModel}">

     <StackPanel x:Name="RootPanel"
                Spacing="16"
                MaxWidth="480">

        <!-- main block -->
        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16,12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- password field + buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding GeneratedPassword}"
                         Style="{StaticResource DefaultTextBoxStyle}"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="15"
                         MinHeight="36"
                         Padding="10,6"
                         Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button Width="36" Height="36"
                            CornerRadius="6"
                            Padding="0"
                            ToolTipService.ToolTip="{loc:StringResource Key=CopyPassword}"
                            Command="{Binding CopyPasswordCommand}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </Button>

                    <Button Width="36" Height="36"
                            CornerRadius="6"
                            Padding="0"
                            ToolTipService.ToolTip="{loc:StringResource Key=RegeneratePassword}"
                            Command="{Binding RegeneratePasswordCommand}"
                            Click="RegenerateButton_Click">
                        <FontIcon x:Name="RefreshIcon"
                                  Glyph="&#xE72C;" FontSize="14"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform/>
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- complexity status -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource ControlFillColorDisabledBrush}">
                    <Grid CornerRadius="2"
                          HorizontalAlignment="Left"
                          Background="{Binding StrengthBrush}"
                          Width="480"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE72E;" FontSize="11"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Foreground="{Binding StrengthBrush}"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:StringResource Key=PasswordStrength}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StrengthLabel}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{Binding StrengthBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- password length -->
        <StackPanel Spacing="6">
            <TextBlock Text="{loc:StringResource Key=PasswordLength}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Slider Grid.Column="0"
                        Minimum="8"
                        Maximum="64"
                        Value="{Binding Length, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>

                <Grid Grid.Column="1" Width="56">
                    <TextBox x:Name="LengthTextBox"
                             Text="{Binding Length,
                                            Mode=TwoWay,
                                            Converter={StaticResource IntToStringConverter},
                                            UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             InputScope="Number"
                             ToolTipService.ToolTip="{loc:StringResource Key=PasswordLengthTooltip}"
                             MinHeight="32"
                             Padding="6,4"
                             KeyDown="LengthTextBox_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="MaxLength" Value="2"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Grid>
            <!-- error message -->
            <TextBlock Text="{Binding LengthError}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding LengthError,
                                    Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- symbols sets -->
        <StackPanel Spacing="6">
            <TextBlock Text="{loc:StringResource Key=CharactersToUse}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox Content="{loc:StringResource Key=UseUppercase}"
                          IsChecked="{Binding UseUppercase, Mode=TwoWay}"
                          ToolTipService.ToolTip="{loc:StringResource Key=UseUppercaseTooltip}"
                          MinWidth="0"/>
                <CheckBox Content="{loc:StringResource Key=UseLowercase}"
                          IsChecked="{Binding UseLowercase, Mode=TwoWay}"
                          ToolTipService.ToolTip="{loc:StringResource Key=UseLowercaseTooltip}"
                          MinWidth="0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox Content="{loc:StringResource Key=UseDigits}"
                          IsChecked="{Binding UseDigits, Mode=TwoWay}"
                          ToolTipService.ToolTip="{loc:StringResource Key=UseDigitsTooltip}"
                          MinWidth="0"/>
                <CheckBox Content="{loc:StringResource Key=UseSpecial}"
                          IsChecked="{Binding UseSpecial, Mode=TwoWay}"
                          ToolTipService.ToolTip="{loc:StringResource Key=UseSpecialTooltip}"
                          MinWidth="0"/>
            </StackPanel>

            <CheckBox Content="{loc:StringResource Key=ExcludeAmbiguousCharacters}"
                      ToolTipService.ToolTip="{loc:StringResource Key=ExcludeAmbiguousTooltip}"
                      IsChecked="{Binding ExcludeAmbiguous, Mode=TwoWay}"
                      MinWidth="0"/>

                <!-- error message -->
            <TextBlock Text="{Binding CharsetsError}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding CharsetsError,
                                    Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>
    </StackPanel>
</views:DialogPage>
