<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central package management (Directory.Packages.props) works best with explicit source mapping.
    This repo uses the public gallery only. To add a private feed, add <add key="..." /> under
    packageSources and map package patterns under packageSourceMapping (see https://aka.ms/nuget-package-source-mapping).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
